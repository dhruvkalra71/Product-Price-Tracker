# Django Secret Key
DJANGO_SECRET_KEY=change-me-in-production-secure-random-key

# Debug mode (set False in production)
DJANGO_DEBUG=True

# Supabase Postgres Connection String (e.g. postgres://postgres:password@db.xxx.supabase.co:5432/postgres)
# If empty, Django defaults to local SQLite db.sqlite3
DATABASE_URL=

# Shared secret header required for POST /api/scrape/run cron triggers
SCRAPE_SHARED_SECRET=ine-tracker-cron-secret-2026

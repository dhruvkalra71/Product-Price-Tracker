# Django settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=False

# Supabase Session Pooler (IPv4-compatible on Render)
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Scraper cron authorization secret
SCRAPE_SHARED_SECRET=ine-tracker-cron-secret-2026

# Connection max age (0 recommended for connection poolers)
CONN_MAX_AGE=0

# Concurrency limit for background automated scraping (default: 1 sequential for safe 512MB RAM usage)
SCRAPE_MAX_CONCURRENT=1
